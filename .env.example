OPENAI_API_KEY=your_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20

NEO4J_URI=<neo4j-uri>
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=graph.v1

EMBEDDING_FILE=data/embeddings/embedding_records.parquet
TOP_K=10
GRAPH_MAX_CHILDREN=20
GRAPH_MAX_NEIGHBORS=20
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

LAW_API_OC=your_law_api_oc
PROJECT_EVAL_PREDICTOR=api
PROJECT_EVAL_API_URL=http://127.0.0.1:8000

